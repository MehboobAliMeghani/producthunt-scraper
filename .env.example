# Product Hunt v2 GraphQL API developer token.
# See the README for how to generate one.
PRODUCT_HUNT_API_TOKEN=your_product_hunt_developer_token_here

# Port the Express server listens on.
PORT=3000

# Apify API token, used by emailScraperService to run the contact-email
# scraper actor (acts/QrqE4kfyNa4tFLJ1M).
APIFY_API_TOKEN=your_apify_api_token_here

# How often (ms) emailScraperService polls an in-progress Apify run.
APIFY_POLL_INTERVAL_MS=20000
